{
  "durationSeconds": 54.55,
  "durationInFrames": 1637,
  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 3.431,
      "startFrame": 4,
      "endFrame": 103,
      "text": "In this town, whatever the teacher writes on the chalkboard comes true."
    },
    "b2": {
      "startSec": 3.571,
      "endSec": 6.972,
      "startFrame": 107,
      "endFrame": 209,
      "text": "Our teacher, Mrs. Vale, writes one rule every single morning."
    },
    "b3": {
      "startSec": 7.052,
      "endSec": 9.69,
      "startFrame": 212,
      "endFrame": 291,
      "text": "Last week she wrote NO TALKING, and the room went silent."
    },
    "b4": {
      "startSec": 9.79,
      "endSec": 12.981,
      "startFrame": 294,
      "endFrame": 389,
      "text": "Then she wrote EVERYONE DANCES, and nobody could stop dancing."
    },
    "w1": {
      "startSec": 13.081,
      "endSec": 13.723,
      "startFrame": 392,
      "endFrame": 412,
      "text": "DANCE!"
    },
    "b5": {
      "startSec": 13.843,
      "endSec": 17.231,
      "startFrame": 415,
      "endFrame": 517,
      "text": "Nobody ever touches the chalk, and nobody erases that board."
    },
    "b6": {
      "startSec": 17.311,
      "endSec": 20.674,
      "startFrame": 519,
      "endFrame": 620,
      "text": "But my little brother Noah was so tired, he fell asleep standing up."
    },
    "b7": {
      "startSec": 20.794,
      "endSec": 23.565,
      "startFrame": 624,
      "endFrame": 707,
      "text": "Mrs. Vale smiled and wrote one soft word: SLEEP."
    },
    "b8": {
      "startSec": 23.685,
      "endSec": 26.107,
      "startFrame": 711,
      "endFrame": 783,
      "text": "Noah woke up, marched to the board, and wiped it away."
    },
    "b9": {
      "startSec": 26.207,
      "endSec": 29.095,
      "startFrame": 786,
      "endFrame": 873,
      "text": "The board went black, then the chalk started writing by itself."
    },
    "w2": {
      "startSec": 29.235,
      "endSec": 29.832,
      "startFrame": 877,
      "endFrame": 895,
      "text": "NOAH!"
    },
    "b10": {
      "startSec": 29.952,
      "endSec": 33.039,
      "startFrame": 899,
      "endFrame": 991,
      "text": "It wrote NOAH, then DETENTION, then one last word: FOREVER."
    },
    "b11": {
      "startSec": 33.199,
      "endSec": 36.38,
      "startFrame": 996,
      "endFrame": 1091,
      "text": "Next morning, Noah's seat was empty, and nobody remembered him."
    },
    "b12": {
      "startSec": 36.54,
      "endSec": 39.275,
      "startFrame": 1096,
      "endFrame": 1178,
      "text": "I ran outside, and the school sign now read NOAH WHO?"
    },
    "b13": {
      "startSec": 39.395,
      "endSec": 42.201,
      "startFrame": 1182,
      "endFrame": 1266,
      "text": "So I grabbed the chalk and wrote the only thing I had left."
    },
    "b14": {
      "startSec": 42.321,
      "endSec": 44.849,
      "startFrame": 1270,
      "endFrame": 1345,
      "text": "The board answered slowly: ONLY THE TEACHER WRITES."
    },
    "w3": {
      "startSec": 45.009,
      "endSec": 45.709,
      "startFrame": 1350,
      "endFrame": 1371,
      "text": "ERASE!"
    },
    "b15": {
      "startSec": 45.829,
      "endSec": 48.615,
      "startFrame": 1375,
      "endFrame": 1458,
      "text": "So I erased every rule, one chalk line at a time."
    },
    "b16": {
      "startSec": 48.715,
      "endSec": 53.846,
      "startFrame": 1461,
      "endFrame": 1615,
      "text": "Noah walked back in, every word disappeared, and one line appeared: TODAY'S RULE. What would you write?"
    }
  },
