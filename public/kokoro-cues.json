{
  "durationSeconds": 46.42,
  "durationInFrames": 1393,
  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 4.363,
      "startFrame": 4,
      "endFrame": 131,
      "text": "In this town, three kids race for one ticket out. The winner saves one family."
    },
    "b2": {
      "startSec": 4.442,
      "endSec": 6.756,
      "startFrame": 133,
      "endFrame": 203,
      "text": "The other two are sent away. This year, I was one."
    },
    "b3": {
      "startSec": 6.816,
      "endSec": 10.192,
      "startFrame": 204,
      "endFrame": 306,
      "text": "I had to win. Mom was sick, and the city had the only doctor."
    },
    "b4": {
      "startSec": 10.272,
      "endSec": 12.635,
      "startFrame": 308,
      "endFrame": 379,
      "text": "June was my best friend. Dex had never won."
    },
    "b5": {
      "startSec": 12.695,
      "endSec": 13.948,
      "startFrame": 381,
      "endFrame": 418,
      "text": "The whole school came to watch."
    },
    "b6": {
      "startSec": 14.008,
      "endSec": 15.375,
      "startFrame": 420,
      "endFrame": 461,
      "text": "The gate opened. We ran."
    },
    "b7": {
      "startSec": 15.435,
      "endSec": 18.52,
      "startFrame": 463,
      "endFrame": 556,
      "text": "I was faster than both of them... until June's leg gave out."
    },
    "b8": {
      "startSec": 18.58,
      "endSec": 20.674,
      "startFrame": 557,
      "endFrame": 620,
      "text": "The rules said keep running. I turned back."
    },
    "b9": {
      "startSec": 20.774,
      "endSec": 22.861,
      "startFrame": 623,
      "endFrame": 686,
      "text": "I matched her pace. Dex passed us both."
    },
    "b10": {
      "startSec": 22.941,
      "endSec": 25.175,
      "startFrame": 688,
      "endFrame": 755,
      "text": "He screamed: you lost your mom's only chance!"
    },
    "b11": {
      "startSec": 25.235,
      "endSec": 26.641,
      "startFrame": 757,
      "endFrame": 799,
      "text": "But at the gate, Dex stopped."
    },
    "b12": {
      "startSec": 26.761,
      "endSec": 29.305,
      "startFrame": 803,
      "endFrame": 879,
      "text": "Years ago, he stopped for a friend and lost everything."
    },
    "b13": {
      "startSec": 29.445,
      "endSec": 31.121,
      "startFrame": 883,
      "endFrame": 934,
      "text": "Now I had the choice he never got."
    },
    "b14": {
      "startSec": 31.241,
      "endSec": 33.292,
      "startFrame": 937,
      "endFrame": 999,
      "text": "June slowed down... and waved me ahead."
    },
    "b15": {
      "startSec": 33.392,
      "endSec": 34.601,
      "startFrame": 1002,
      "endFrame": 1038,
      "text": "I could have stopped. I didn't."
    },
    "b16": {
      "startSec": 34.721,
      "endSec": 37.026,
      "startFrame": 1042,
      "endFrame": 1111,
      "text": "I won. I chose my mom. She got treatment."
    },
    "b17": {
      "startSec": 37.126,
      "endSec": 40.191,
      "startFrame": 1114,
      "endFrame": 1206,
      "text": "That night, June's family was sent away. She looked back once."
    },
    "b18": {
      "startSec": 40.291,
      "endSec": 43.044,
      "startFrame": 1209,
      "endFrame": 1291,
      "text": "She said she'd do the same. I still don't know if that's true."
    },
    "b19": {
      "startSec": 43.204,
      "endSec": 45.719,
      "startFrame": 1296,
      "endFrame": 1372,
      "text": "Who would you have saved: your mom... or your best friend?"
    }
  },
